{
 "schemaVersion": 1,
 "id": "example-sales-overview",
 "title": "Sales example",
 "createdAt": 0,
 "sources": [
  {
   "id": "example-sales",
   "kind": "file",
   "name": "Sales.xlsx",
   "format": "xlsx",
   "path": "${EXAMPLES}/Sales.xlsx",
   "tables": [
    {
     "alias": "transactions",
     "ref": "Transactions"
    }
   ],
   "refresh": {
    "onOpen": true,
    "watch": true,
    "onFocus": true,
    "everyMin": 0
   }
  },
  {
   "id": "example-customers",
   "kind": "file",
   "name": "customers.csv",
   "format": "csv",
   "path": "${EXAMPLES}/customers.csv",
   "tables": [
    {
     "alias": "customers"
    }
   ],
   "refresh": {
    "onOpen": true,
    "watch": true,
    "onFocus": true,
    "everyMin": 0
   }
  }
 ],
 "datasets": [
  {
   "id": "example-dataset",
   "name": "sales",
   "sql": "SELECT t.order_id, t.order_date, t.customer_id, c.customer_name, c.region, c.segment, t.product_name, t.quantity,\n  t.revenue, t.cost, t.revenue - t.cost AS profit\nFROM transactions t LEFT JOIN customers c USING (customer_id)",
   "description": "Orders with their customer, region and profit"
  }
 ],
 "queries": [
  {
   "id": "example-query",
   "name": "Revenue and profit by segment",
   "sql": "SELECT segment, round(sum(revenue)) AS revenue, round(sum(profit)) AS profit\nFROM sales\nGROUP BY segment\nORDER BY revenue DESC"
  }
 ],
 "charts": [
